PORT=5000
NODE_ENV=development
# Recommended for deployment. If empty, the API saves orders to backend/data/orders.json locally.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
# Comma-separated frontend origins, for example http://localhost:5173,https://your-site.vercel.app
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_ORDER_TOTAL=1000000
